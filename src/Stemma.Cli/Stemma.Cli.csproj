<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Stemma.Cli</RootNamespace>
    <AssemblyName>stemma</AssemblyName>
    <!-- Playwright's generated API surface is large and not ours to annotate. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Stemma.Engine\Stemma.Engine.csproj" />
    <PackageReference Include="Microsoft.Playwright" Version="1.61.0" />
  </ItemGroup>
</Project>
