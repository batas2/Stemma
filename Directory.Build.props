<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1903;NU1902</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Authors>Bartosz Frąckowiak</Authors>
    <Copyright>Copyright 2026 Bartosz Frąckowiak</Copyright>
    <RepositoryUrl>https://github.com/batas2/Stemma</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/batas2/Stemma</PackageProjectUrl>
  </PropertyGroup>
</Project>
