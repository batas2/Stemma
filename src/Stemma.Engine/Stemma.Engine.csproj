<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Stemma.Engine</RootNamespace>
    <AssemblyName>Stemma.Engine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- Model-only workspaces are compiled against the shipped Stemma.Model assembly (ADR-0016), so
         it has to sit next to the engine wherever the engine is deployed. Conventions rule 6 allows
         exactly this dependency: Roslyn + Stemma.Model, nothing else. -->
    <ProjectReference Include="..\Stemma.Model\Stemma.Model.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.14.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Markdig" Version="0.41.0" />
    <PackageReference Include="YamlDotNet" Version="16.2.1" />
  </ItemGroup>
</Project>
