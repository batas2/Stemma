<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1903;NU1902</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- The one place the version is stated. Every assembly is stamped with it, the version flags
         and the diagnostics bundle read it back from there, and a release tag must match it (F-012). -->
    <VersionPrefix>0.1.0</VersionPrefix>
    <Authors>Bartosz Frąckowiak</Authors>
    <Copyright>Copyright 2026 Bartosz Frąckowiak</Copyright>
    <RepositoryUrl>https://github.com/batas2/Stemma</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://bfrackowiak.pl/stemma/</PackageProjectUrl>
  </PropertyGroup>
</Project>
