{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/batas2/Stemma/main/schema/stemma.layout.schema.json",
  "title": "stemma.layout.json",
  "description": "The committed presentation layer for a Stemma workspace: everything about how the architecture is drawn and annotated, without being part of the canonical code model. The model itself lives in Architecture.cs and is not described here.\n\nThis format is deliberately PASS-THROUGH: the web client owns the schema of the rich sections and the engine persists them verbatim. Every object here therefore allows additional properties, and a reader that does not recognise a member must preserve it rather than drop it. Dropping unknown members inside a view is what B-001 was.\n\nThis schema is documentation and editor support, not a gate. It is hand-maintained against the TypeScript types in src/Stemma.Web.Client/src/lib/ (layout.ts, nodeStyles.ts, edgeStyles.ts, shapes.ts, books.ts) and the C# type in src/Stemma.Engine/Workspace/LayoutSidecar.cs.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Pointer to this schema, written automatically so editors validate the file live."
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Sidecar format version. Must match LayoutSidecar.Version in the engine.",
      "const": 1
    },
    "views": {
      "type": "object",
      "description": "Per-view presentation, keyed by view key: a built-in lens ('moduleMap', 'dependencyGraph') or a custom view as 'custom:<viewId>'.",
      "additionalProperties": {
        "$ref": "#/$defs/viewLayout"
      }
    },
    "nodeStyles": {
      "type": "object",
      "description": "Per-element node appearance, keyed by element id. Workspace-wide, not per view.",
      "additionalProperties": {
        "$ref": "#/$defs/nodeStyle"
      }
    },
    "edgeStyles": {
      "type": "object",
      "description": "Per-relationship edge appearance, keyed by link id. Workspace-wide, not per view.",
      "additionalProperties": {
        "$ref": "#/$defs/edgeStyle"
      }
    },
    "notes": {
      "type": "object",
      "description": "Per-element Markdown notes, keyed by element id.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "customProps": {
      "type": "object",
      "description": "Per-element user-defined properties, keyed by element id. Values are free-form.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "books": {
      "type": "object",
      "description": "Books, keyed by book id: ordered walks through the model for one audience, presented from the canvas and included in the report and the PDF. Pure presentation (ADR-0022): a book asserts nothing about the system, and deleting one leaves the architecture exactly as true as it was. Pages refer to views and elements by id, which `stemma validate` checks, so a page that outlives what it points at is reported rather than quietly showing something else.",
      "additionalProperties": {
        "$ref": "#/$defs/book"
      }
    },
    "annotations": {
      "type": "object",
      "description": "LEGACY, keyed by view key. Superseded by views.<key>.shapes, which is where the canvas has written free-form annotation since. Still read and preserved so older workspaces keep their content; nothing writes it today. Do not author new content here.",
      "deprecated": true,
      "additionalProperties": true
    }
  },
  "$defs": {
    "book": {
      "type": "object",
      "description": "One walk through the model. Mirrors what lib/books.ts reads. Pages are an object keyed by page id with their order kept apart in `order`, so that editing one page's narrative is one change to the file rather than a rewrite of every page.",
      "additionalProperties": true,
      "required": [
        "name",
        "pages"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Shown in the books panel and on the cover of the book's PDF."
        },
        "audience": {
          "type": "string",
          "description": "Who the book is for, as free text, e.g. 'engineering'. Shown, not filtered on."
        },
        "order": {
          "type": "array",
          "description": "Page ids in the order they are presented. Pages it does not name follow the ones it does, in file order, so a book written by hand without an `order` still presents. An id with no page is skipped.",
          "items": {
            "type": "string"
          }
        },
        "pages": {
          "type": "object",
          "description": "The book's pages, keyed by page id.",
          "additionalProperties": {
            "$ref": "#/$defs/bookPage"
          }
        }
      }
    },
    "bookPage": {
      "type": "object",
      "description": "One page of a book: the view it shows, what to point at in it, how to frame it, and the words to say over it. It refers to the model by id and copies nothing out of it, so a rename in code is a rename on the page.",
      "additionalProperties": true,
      "required": [
        "title",
        "view"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "view": {
          "type": "string",
          "description": "The view the page shows: 'moduleMap', 'dependencyGraph', or the id of a view declared in Views/*.cs. The bare id ('view_buy'), not the 'custom:view_buy' key the same view has under `views`."
        },
        "narrative": {
          "type": "string",
          "description": "Markdown, said over the diagram. A paragraph break is written \\n\\n."
        },
        "focus": {
          "type": "array",
          "description": "Element ids the page points at. They, the links between two of them, and a bounded context holding one stay lit; everything else is dimmed or hidden, per `others`. Absent or empty means the page is about the whole view.",
          "items": {
            "type": "string"
          }
        },
        "frame": {
          "enum": [
            "view",
            "focus"
          ],
          "description": "Frame the whole view, or zoom to the focus. Absent means 'focus' when the page has a focus and 'view' when it does not."
        },
        "others": {
          "enum": [
            "dim",
            "hide"
          ],
          "description": "What happens to the elements outside the focus. Absent means 'dim'."
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "viewLayout": {
      "type": "object",
      "description": "How one view is drawn. Unknown members here must survive a round trip — this is the object B-001 silently truncated.",
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "object",
          "description": "Node positions in flow coordinates, keyed by element id.",
          "additionalProperties": {
            "$ref": "#/$defs/position"
          }
        },
        "edges": {
          "type": "object",
          "description": "Per-edge routing overrides for this view, keyed by link id.",
          "additionalProperties": {
            "$ref": "#/$defs/edgeEntry"
          }
        },
        "shapes": {
          "type": "array",
          "description": "Free-form annotation drawn on this view. Pure presentation: never part of the model, always safe to delete.",
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/shape"
          }
        },
        "layoutMode": {
          "enum": [
            "custom",
            "force",
            "hierarchical",
            "byType"
          ],
          "description": "How the view is arranged. 'custom' means the stored `nodes` positions are authoritative; the others re-run on open and overwrite them. Absent means 'custom'."
        },
        "layout": {
          "$ref": "#/$defs/layoutConstraint",
          "description": "A declarative arrangement, solved to coordinates on open. Governs only the ids it names; everything else keeps its `nodes` position. Unlike `layoutMode`, this stays live: a drag records an entry in `offsets` rather than replacing the constraint."
        },
        "offsets": {
          "type": "object",
          "description": "Per-node nudges applied on top of the solved constraint, keyed by element id. Stored as deltas so a nudge travels with its slot when the arrangement is re-solved.",
          "additionalProperties": {
            "$ref": "#/$defs/position"
          }
        },
        "header": {
          "$ref": "#/$defs/viewHeader"
        }
      }
    },
    "viewHeader": {
      "type": "object",
      "description": "What the view is, the one sentence it should leave in the room, how to read it, and what its colours mean (F-014, ADR-0023). Drawn across the top of the canvas, when presented, in the PDF deck and in the report; not by `stemma render`.",
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string",
          "description": "Shown instead of the view's name."
        },
        "message": {
          "type": "string",
          "description": "The one sentence the view should leave in the room."
        },
        "context": {
          "type": "string",
          "description": "Markdown: what the view shows and how to read it. **bold**, *italic*, `code`, `- ` lists."
        },
        "legend": {
          "type": "array",
          "description": "Absent: computed from what the view draws — each lifecycle status its elements carry, then each kind of link. Written: replaces the computed one. Empty: no legend.",
          "items": {
            "$ref": "#/$defs/legendEntry"
          }
        }
      }
    },
    "legendEntry": {
      "description": "One line of a view's legend.",
      "oneOf": [
        {
          "title": "status",
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "type": "string",
              "description": "A lifecycle status; its swatch is drawn the way the view's cards with that status are drawn."
            },
            "label": {
              "type": "string",
              "description": "Defaults to the status."
            }
          }
        },
        {
          "title": "swatch",
          "type": "object",
          "required": [
            "swatch",
            "label"
          ],
          "properties": {
            "swatch": {
              "type": "object",
              "properties": {
                "fill": {
                  "type": "string"
                },
                "border": {
                  "type": "string"
                },
                "style": {
                  "enum": [
                    "solid",
                    "dashed",
                    "dotted"
                  ]
                }
              }
            },
            "label": {
              "type": "string"
            }
          }
        },
        {
          "title": "line",
          "type": "object",
          "required": [
            "line",
            "label"
          ],
          "properties": {
            "line": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string"
                },
                "style": {
                  "enum": [
                    "solid",
                    "dashed",
                    "dotted"
                  ]
                }
              }
            },
            "label": {
              "type": "string"
            }
          }
        }
      ]
    },
    "edgeEntry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "waypoints": {
          "type": "array",
          "description": "Manual bend points, in flow coordinates.",
          "items": {
            "$ref": "#/$defs/position"
          }
        },
        "labelOffset": {
          "$ref": "#/$defs/position",
          "description": "Displacement of the edge label from its default midpoint."
        },
        "handles": {
          "type": "object",
          "description": "draw.io-style dock anchors: which connection dot each end attaches to.",
          "additionalProperties": true,
          "properties": {
            "source": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          }
        }
      }
    },
    "nodeStyle": {
      "type": "object",
      "description": "Mirrors NodeStyle in lib/nodeStyles.ts. Every member is optional; an absent member means the theme default.",
      "additionalProperties": true,
      "properties": {
        "fillColor": {
          "type": "string"
        },
        "borderColor": {
          "type": "string"
        },
        "borderWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "borderStyle": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "animated": {
          "type": "boolean",
          "deprecated": true,
          "description": "Legacy marching-ants flag, migrated to animation: 'marching'."
        },
        "animation": {
          "enum": [
            "none",
            "marching",
            "pulse",
            "glow",
            "breathe",
            "bounce",
            "shake"
          ]
        },
        "animationSpeed": {
          "enum": [
            "slow",
            "normal",
            "fast"
          ]
        },
        "fillStyle": {
          "enum": [
            "solid",
            "gradient",
            "glass",
            "hatch"
          ]
        },
        "shadow": {
          "enum": [
            "none",
            "soft",
            "raised",
            "glow"
          ]
        },
        "opacity": {
          "type": "number",
          "minimum": 0.2,
          "maximum": 1
        },
        "accentSide": {
          "enum": [
            "none",
            "left",
            "top"
          ]
        },
        "accentColor": {
          "type": "string"
        },
        "textColor": {
          "type": "string"
        },
        "textSize": {
          "enum": [
            "sm",
            "base",
            "lg",
            "xl"
          ]
        },
        "textAlign": {
          "enum": [
            "left",
            "center"
          ]
        },
        "visibleFields": {
          "type": "array",
          "description": "Which rows the node body renders. Built-in field keys (kind, name, id, contextId, systemId, containerKind, squad, domain, status, phase, narrativePreview) plus any custom property name. Default: kind, name, contextId, squad, status.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "edgeStyle": {
      "type": "object",
      "description": "Mirrors EdgeStyle in lib/edgeStyles.ts.",
      "additionalProperties": true,
      "properties": {
        "thickness": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "lineStyle": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        },
        "routing": {
          "enum": [
            "bezier",
            "smoothstep",
            "step",
            "straight"
          ]
        },
        "color": {
          "type": "string"
        },
        "animated": {
          "type": "boolean"
        },
        "animSpeed": {
          "enum": [
            "slow",
            "normal",
            "fast"
          ]
        },
        "arrow": {
          "$ref": "#/$defs/edgeArrow",
          "deprecated": true,
          "description": "Legacy alias for arrowEnd."
        },
        "arrowStart": {
          "$ref": "#/$defs/edgeArrow"
        },
        "arrowEnd": {
          "$ref": "#/$defs/edgeArrow"
        }
      }
    },
    "edgeArrow": {
      "enum": [
        "none",
        "closed",
        "open",
        "circle",
        "diamond",
        "pipe"
      ]
    },
    "shapeBase": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "rect",
            "ellipse",
            "triangle",
            "label",
            "arrow",
            "image"
          ]
        },
        "z": {
          "type": "number",
          "description": "Stacking order. Below zero, the shape is a backdrop, drawn beneath the cards and the links (B-019); zero and above, over them. Ordered by z within each side. New rects and ellipses default to -1."
        }
      }
    },
    "shapeBoxText": {
      "type": "object",
      "description": "Text and finish shared by the box-like shapes (rect / ellipse / triangle).",
      "properties": {
        "label": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Markdown body, wrapped inside the box: **bold**, *italic*, `code`, `- ` lists. Rendered as text, never as markup."
        },
        "textColor": {
          "type": "string"
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "fillStyle": {
          "enum": [
            "solid",
            "gradient"
          ]
        },
        "shadow": {
          "enum": [
            "none",
            "soft",
            "raised",
            "glow"
          ]
        },
        "animation": {
          "enum": [
            "none",
            "marching",
            "pulse",
            "breathe"
          ]
        }
      }
    },
    "shapeBox": {
      "type": "object",
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number"
        },
        "h": {
          "type": "number"
        },
        "fill": {
          "type": "string"
        },
        "stroke": {
          "type": "string"
        },
        "strokeWidth": {
          "type": "number"
        },
        "strokeStyle": {
          "enum": [
            "solid",
            "dashed",
            "dotted"
          ]
        },
        "rounded": {
          "type": "boolean",
          "description": "rect only."
        }
      }
    },
    "arrowAnchor": {
      "description": "Where an arrow endpoint lives. An anchored endpoint follows its target; a free one does not.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "x",
            "y"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "free"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "id"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "enum": [
                "element",
                "shape"
              ]
            },
            "id": {
              "type": "string"
            }
          }
        }
      ]
    },
    "shape": {
      "description": "One free-form annotation. Discriminated by `kind`.",
      "allOf": [
        {
          "$ref": "#/$defs/shapeBase"
        }
      ],
      "oneOf": [
        {
          "title": "rect / ellipse / triangle",
          "allOf": [
            {
              "$ref": "#/$defs/shapeBox"
            },
            {
              "$ref": "#/$defs/shapeBoxText"
            }
          ],
          "properties": {
            "kind": {
              "enum": [
                "rect",
                "ellipse",
                "triangle"
              ]
            }
          }
        },
        {
          "title": "label",
          "required": [
            "x",
            "y",
            "text"
          ],
          "properties": {
            "kind": {
              "const": "label"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "text": {
              "type": "string"
            },
            "fontSize": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string"
            }
          }
        },
        {
          "title": "arrow",
          "required": [
            "fromX",
            "fromY",
            "toX",
            "toY"
          ],
          "properties": {
            "kind": {
              "const": "arrow"
            },
            "fromX": {
              "type": "number"
            },
            "fromY": {
              "type": "number"
            },
            "toX": {
              "type": "number"
            },
            "toY": {
              "type": "number"
            },
            "fromAnchor": {
              "$ref": "#/$defs/arrowAnchor"
            },
            "toAnchor": {
              "$ref": "#/$defs/arrowAnchor"
            },
            "stroke": {
              "type": "string"
            },
            "strokeWidth": {
              "type": "number"
            },
            "strokeStyle": {
              "enum": [
                "solid",
                "dashed",
                "dotted"
              ]
            },
            "label": {
              "type": "string"
            },
            "linkKind": {
              "enum": [
                "dataFlow",
                "dependency"
              ],
              "description": "Mirrors ArchLink.kind so annotation arrows read like model links. Defaults to dataFlow."
            },
            "linkSubKind": {
              "type": "string",
              "description": "dependency only: the verb (uses / calls / publishes / …). Free text."
            },
            "payload": {
              "type": "string",
              "description": "dataFlow only: what flows."
            }
          }
        },
        {
          "title": "image",
          "required": [
            "x",
            "y",
            "w",
            "h",
            "src"
          ],
          "properties": {
            "kind": {
              "const": "image"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "w": {
              "type": "number"
            },
            "h": {
              "type": "number"
            },
            "src": {
              "type": "string",
              "description": "A built-in stencil id ('stencil:database') or a data: URL."
            },
            "label": {
              "type": "string"
            }
          }
        }
      ]
    },
    "layoutConstraint": {
      "description": "Layout as intent rather than pixels. Only deterministic arrangements belong here: re-solving must give the same picture, which is why the iterative auto-layouts (force, hierarchical, byType) are `layoutMode` generators that bake coordinates instead.",
      "oneOf": [
        {
          "title": "grid",
          "type": "object",
          "required": [
            "kind",
            "columns"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "grid"
            },
            "columns": {
              "type": "array",
              "description": "Column-major: columns[i] is the ids in column i, top to bottom.",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "gap": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "align": {
              "enum": [
                "start",
                "center"
              ]
            }
          }
        },
        {
          "title": "row",
          "type": "object",
          "required": [
            "kind",
            "ids"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "row"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gap": {
              "type": "number"
            },
            "align": {
              "enum": [
                "start",
                "center"
              ]
            }
          }
        },
        {
          "title": "column",
          "type": "object",
          "required": [
            "kind",
            "ids"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "column"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "gap": {
              "type": "number"
            },
            "align": {
              "enum": [
                "start",
                "center"
              ]
            }
          }
        },
        {
          "title": "stack",
          "type": "object",
          "required": [
            "kind",
            "ids"
          ],
          "additionalProperties": true,
          "properties": {
            "kind": {
              "const": "stack"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "step": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      ]
    }
  }
}
