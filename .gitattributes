# Round-trip fidelity compares bytes: a CRLF checkout would turn every edited file into a
# whole-file diff and fail the fidelity suite on Windows. Normalise on commit, check out LF.
* text=auto eol=lf

# The pathological fidelity fixtures mix CRLF and LF on purpose. Normalising one would delete the
# case it exists to cover, and the suite would go on passing.
tests/Stemma.Engine.Tests/Fixtures/arch/pathological.cs -text
tests/Stemma.Engine.Tests/Fixtures/types/pathological.cs -text

# Except the formats that genuinely require CRLF to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary — never touch, never diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# Generated or vendored: keep them out of diffs and language stats.
src/Stemma.Web.Client/package-lock.json linguist-generated=true
*.stemma.json linguist-generated=true
